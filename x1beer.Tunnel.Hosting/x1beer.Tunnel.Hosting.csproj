<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>x1beer.Tunnel.Hosting</RootNamespace>
    <AssemblyName>x1beer.Tunnel.Hosting</AssemblyName>
    <PackageId>x1beer.Tunnel.Hosting</PackageId>
    <Version>0.2.0</Version>
    <Description>ASP.NET Core hosted service that opens a local HTTPS tunnel after Kestrel starts listening.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DependencyInjection\**\*.cs" Link="DependencyInjection\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\x1tunnel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="x1beer.Tunnel.Tests" />
  </ItemGroup>
</Project>
